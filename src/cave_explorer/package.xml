<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cave_explorer</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="graeme.best@uts.edu.au">Graeme Best</maintainer>
  <license>TODO: License declaration</license>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Mission Control GUI (cave_explorer/gui.py) -->
  <exec_depend>python3-pyqt5</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <!-- Make package available to gazebo too (to find models) -->
    <gazebo_ros gazebo_model_path="${prefix}/../"/>
  </export>
</package>
